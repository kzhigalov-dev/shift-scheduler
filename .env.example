# Приложение, роль app_user. Локально — supabase start; на бою — пулер Supabase, порт 6543.
DATABASE_URL=postgres://app_user:app_user_local@127.0.0.1:54322/postgres
# Тесты: только локальная база с именем *_test, от суперпользователя.
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:54322/shift_test
# Тесты под ролью приложения на той же тестовой базе.
DATABASE_URL_TEST_APP=postgres://app_user:app_user_local@127.0.0.1:54322/shift_test
# scrypt-хеш пароля менеджера, формат соль:хеш. Сгенерировать: scripts/hash-password.mjs
MANAGER_PASSWORD_HASH=
# Telegram-бот (не обязательно: без ключа бот «не настроен»). Ключ — только на Vercel и локально при отладке.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=DemoShiftsBot

# Необязательный импорт из собственных общедоступных Google-таблиц.
# Только ID, не полный URL. Значения NEXT_PUBLIC видны в браузере и фиксируются при сборке.
NEXT_PUBLIC_GOOGLE_STAFF_SHEET_ID=
NEXT_PUBLIC_GOOGLE_SCHEDULE_SHEET_ID=
NEXT_PUBLIC_GOOGLE_CONCERTS_SHEET_ID=
